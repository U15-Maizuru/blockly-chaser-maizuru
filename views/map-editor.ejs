<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1680, user-scalable=no">
  <title>CHaser マップエディタ</title>
  <link rel="icon" href="/images/favicon.ico">
  <%- include('./common/head-assets') %>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/menu.css' />
  <link rel='stylesheet' href='/stylesheets/map-tiles.css' />
  <link rel='stylesheet' href='/stylesheets/map-editor.css' />
</head>

<body>
  <%- include('./common/config', {LNG: C_LNG}) %>

  <% const headerActionsHtml = '<button id="configButton" class="bc-btn-labeled" title="設定" aria-label="設定">設定</button>'; %>
  <%- include('./common/header', { backHref: '/menu-match', titleHtml: title, actionsHtml: headerActionsHtml }) %>

  <div id="editor_root">
    <div id="editor_area">

      <div id="editor_settings">
        <label class="setting_label">マップ名
          <input id="map_name" type="text" placeholder="マイマップ" maxlength="30">
        </label>
        <label class="setting_label">ターン数
          <input id="map_turn" type="number" min="1" max="500" value="100">
        </label>
        <label class="setting_label">幅
          <input id="map_size_x" type="number" min="5" max="30" value="15">
        </label>
        <label class="setting_label">高さ
          <input id="map_size_y" type="number" min="5" max="30" value="17">
        </label>
        <button id="btn_resize">サイズ変更</button>
      </div>

      <div id="editor_main">
        <div id="editor_grid_wrap">
          <div id="editor_grid"></div>
        </div>

        <div id="editor_controls">
          <div id="editor_toolbar">
            <button class="tool_btn tool_btn_active" data-tool="floor">床</button>
            <button class="tool_btn" data-tool="block">ブロック</button>
            <button class="tool_btn" data-tool="item">アイテム</button>
            <button class="tool_btn" data-tool="cool">プレイヤ(Cool)</button>
            <button class="tool_btn" data-tool="hot">対戦AI(Hot)</button>
          </div>

          <div id="editor_symmetry">
            <button class="sym_btn sym_btn_active" data-mode="none">通常</button>
            <button class="sym_btn" data-mode="mirror">ミラー</button>
            <button class="sym_btn" data-mode="rotate">回転対称</button>
          </div>

          <div id="editor_file_bar">
            <label for="load_map_file" id="btn_load">マップを読み込む</label>
            <input type="file" id="load_map_file" accept=".json" style="display:none">
            <button id="btn_random">ランダムマップ生成</button>
            <button id="btn_clear">クリア</button>
          </div>

          <div id="editor_footer">
            <button id="btn_create">対戦ルームを作成</button>
            <button id="btn_download">ダウンロード</button>
            <div id="editor_status"></div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script src="/javascripts/map_format.js"></script>
  <script src="/javascripts/map_grid_ui.js"></script>
  <script src="/javascripts/map_random_gen.js"></script>
  <script src="/javascripts/map-editor.js"></script>
</body>

</html>
