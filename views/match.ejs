<!DOCTYPE html>
<html>

<head>
  <%- include('common/gtag.js') %>

  <meta charset="utf-8">
  <meta name="viewport" content="width=1680, user-scalable=no">
  <title>CHaser Match</title>
  <link rel="icon" href="/images/favicon.ico">
  <%- include('./common/head-assets') %>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/menu.css' />
  <link rel='stylesheet' href='/stylesheets/game-board.css' />
  <link rel='stylesheet' href='/stylesheets/match.css' />

  <script src="/socket.io/socket.io.js"></script>
  <script src="/javascripts/jquery-3.4.1.min.js"></script>

  <script src="/javascripts/howler.min.js"></script>

  <script src="/javascripts/socket_events.js"></script>
  <script src="/javascripts/match.js"></script>
  <script src="/javascripts/game_board.js"></script>
</head>

<body>
  <%- include('./common/config', {LNG: C_LNG}) %>
  <%
    const headerActionsHtml = '<button id="fullscreenButton" onclick="reqFullscreen(\'contents_area\')" class="bc-btn-labeled" title="最大化" aria-label="最大化">最大化</button>' +
      '<button id="configButton" class="bc-btn-labeled" title="設定" aria-label="設定">設定</button>';
  %>
  <%- include('./common/header', { backHref: './menu-match', titleSpan: '対戦', titleHtml: '<div id="server_name"></div>', actionsHtml: headerActionsHtml }) %>
  <div id="contents_area">
    <div id="ready_area">
      <div id="cool_ready_title">cool</div>
      <div id="cool_ready">
        <iframe id="cool_player_iframe" class="player_iframe"></iframe>
      </div>
      <div id="hot_ready_title">hot</div>
      <div id="hot_ready">
        <iframe id="hot_player_iframe" class="player_iframe"></iframe>
      </div>
      <div id="game_start" class="display_init">ゲームスタート</div>
    </div>
    <div id="game_area" class="display_off">
      <div id="game_board"></div>
      <div id="game_info"></div>
    </div>
  </div>


</body>

</html>