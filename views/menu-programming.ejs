<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1680, user-scalable=no">
  <title><%= htmlTitle %></title>
  <link rel="icon" href="/images/favicon.ico">
  <%- include('./common/head-assets') %>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/menu.css' />
  <link rel='stylesheet' href='/stylesheets/menu-programming.css' />

    <script>window.PROGRAMMING_PATH = "<%= programmingPath %>";</script>
    <script src="/javascripts/jquery-3.4.1.min.js"></script>
    <script src="/javascripts/fflate.js"></script>
    <script src="/javascripts/scroll-x.js"></script>

</head>

<body>
  <%- include('./common/config', {LNG: C_LNG}) %>

    <% const headerActionsHtml = `<button id="configButton" class="bc-btn-labeled" title="${LNG["CONFIG"]}" aria-label="${LNG["CONFIG"]}">${LNG["CONFIG"]}</button>`; %>
    <%- include('./common/header', { backHref: '../', titleSpan: 'プログラミング', titleHtml: title, actionsHtml: headerActionsHtml }) %>

    <div class="content">
      <div class="select_data">
        <div class="slider-x">
          <div></div>
          <div></div>
          <div>
            <div class="onebox" id="d1">
              <div class="inbox">
                <a href="#d1"></a>
                <div class="boxtitle"><%- LNG["NEW_DATA"] %></div>
                <div class="boxnewimage"></div>
                <div class="boxinfo"><%- LNG["NEW_DATA_INFO"] %></div>
              </div>
            </div>
          </div>
          <div>
            <div class="onebox" id="d2">
              <div class="inbox">
                <a href="#d2"></a>
                <div class="boxtitle"><%- LNG["OPEN_DATA"] %></div>
                <div class="boxopenimage"></div>
                <div class="boxinfo"><%- LNG["OPEN_DATA_INFO"] %></div>
              </div>
            </div>
          </div>
          <div>
            <div class="onebox" id="d3">
              <div class="inbox">
                <a href="#d3"></a>
                <div class="boxtitle"><%- LNG["REOPEN_DATA"] %></div>
                <div class="boxdbimage"></div>
                <div class="boxinfo"><%- LNG["REOPEN_DATA_INFO"] %></div>
              </div>
            </div>
          </div>
          <div></div>
          <div></div>
        </div>
      </div>

      <div class="button_area">
        <div class="select_button">はじめる</div>
        <label id="loadstart" for="file_load">
          はじめる
          <input type="file" accept="application/zip,.blch,.json,.xml" id="file_load" style="display:none;">
        </label>
      </div>
    </div>

</body>

</html>