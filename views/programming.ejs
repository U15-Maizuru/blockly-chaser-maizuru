<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1680, user-scalable=no">
  <meta name="google" value="notranslate">

  <title><%= htmlTitle %></title>
  <link rel="icon" href="/images/favicon.ico">

  <script src="/socket.io/socket.io.js"></script>
  <script src="/javascripts/blockly/blockly_compressed.js"></script>
  <script src="/javascripts/blockly/blocks_compressed.js"></script>

  <script src="/javascripts/blocks/chaser_block.js"></script>

  <script src="/javascripts/blockly/generators/javascript_compressed.js"></script>
  <script src="/javascripts/generators/javascript_chaser.js"></script>

  <script src="/javascripts/blockly/generators/python_compressed.js"></script>
  <script src="/javascripts/generators/python_chaser.js"></script>

  <script src="/javascripts/acorn_interpreter.js"></script>

  <script src="/javascripts/howler.min.js"></script>

  <script src="/javascripts/blockly_inject_options.js"></script>
  <script src="/javascripts/code.js"></script>
  <script src="/javascripts/socket_events.js"></script>
  <script src="/javascripts/game_server_client.js"></script>



  <%- include('./common/head-assets') %>
  <% if (expMode) { %>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/blockly.css' />
  <% } else { %>
  <link rel='stylesheet' href='/stylesheets/blockly.css' />
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <% } %>
</head>

<body>
  <%- include('./common/config', {LNG: C_LNG}) %>
  <%
    const headerActionsHtml = `
      <button id="runButton" class="bc-btn-labeled" title="${LNG["RUN"]}" aria-label="${LNG["RUN"]}">${LNG["RUN"]}</button>
      <button id="stopButton" class="bc-btn-labeled" title="${LNG["STOP"]}" aria-label="${LNG["STOP"]}">${LNG["STOP"]}</button>
      <button id="trashButton" class="bc-btn-labeled" title="${LNG["TRASH"]}" aria-label="${LNG["TRASH"]}">${LNG["TRASH"]}</button>
      <button id="downloadButton" class="bc-btn-labeled" title="${LNG["SAVE"]}" aria-label="${LNG["SAVE"]}">${LNG["SAVE"]}</button>
      <button id="downloadPythonButton" class="bc-btn-labeled" title="Pythonで保存" aria-label="Pythonで保存">Python保存</button>
      <label for="file_load" class="bc-btn-labeled" title="${LNG["LOAD"]}" aria-label="${LNG["LOAD"]}">
        ${LNG["LOAD"]}
        <input type="file" accept="application/zip,.blch,.json,.xml" id="file_load" style="display:none;">
      </label>
      <button id="configButton" class="bc-btn-labeled" title="設定" aria-label="設定">設定</button>
    `;
  %>
  <%- include('./common/header', { backHref: menuPath, titleSpan: 'プログラミング', titleHtml: title + levelLabel, actionsHtml: headerActionsHtml }) %>

  <div id="scale_root">
    <div id="main_area">
      <div class="left_area">
        <div class="tab_area">
          <ul class="blockly_menu">
            <li id="tab_blocks" class="tabon">プログラムブロック</li>
            <li id="tab_python" class="taboff">python</li>
            <li id="tab_javascript" class="taboff">javascript</li>
            <li id="tab_json" class="taboff">json</li>
            <li id="tab_xml" class="taboff">xml</li>
          </ul>
        </div>

        <div class="blockly_area" id="content_area"></div>

        <div id="content_blocks" class="content"></div>
        <pre id="content_python" class="content" wrap="off"></pre>
        <pre id="content_javascript" class="content lang-js"></pre>
        <pre id="content_json" class="content" wrap="off"></pre>
        <pre id="content_xml" class="content" wrap="off"></pre>
      </div>

      <div class="right_area">

        <div class="game_area">
          <div id="game_board"></div>
          <div id="game_info"></div>
        </div>
        <textarea class="console_area" id="output" disabled="disabled"></textarea>

      </div>
    </div>
  </div>

  <script src="/javascripts/fflate.js"></script>
  <script>const APP_VERSION = "<%= appVersion %>";</script>
  <script src="/javascripts/encode_core.js"></script>
  <script src="/javascripts/encode.js"></script>
  <xml xmlns="https://developers.google.com/blockly/xml" id="toolbox" style="display: none">
    <%- include(toolboxPartial) %>
  </xml>

</body>

</html>