<!DOCTYPE html>
<html>

<head>
  <%- include('common/gtag.js') %>
  
  <meta charset="utf-8">
  <meta name="viewport" content="width=1680, user-scalable=no">
  <title>CHaser Match Menu</title>
  <link rel="icon" href="/images/favicon.ico">
  <%- include('./common/head-assets') %>
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <link rel='stylesheet' href='/stylesheets/menu.css' />
  <link rel='stylesheet' href='/stylesheets/menu-watching.css' />

    <script src="/javascripts/jquery-3.4.1.min.js"></script>

    <script>const lng_list = <%- JSON.stringify(LNG) %>;</script>


</head>

<body>
  <%- include('./common/config', {LNG: C_LNG}) %>

    <% const headerActionsHtml = `<button id="configButton" class="bc-btn-labeled" title="${LNG["CONFIG"]}" aria-label="${LNG["CONFIG"]}">${LNG["CONFIG"]}</button>`; %>
    <%- include('./common/header', { backHref: '../', titleSpan: LNG["TITLE"], titleHtml: title, actionsHtml: headerActionsHtml }) %>

    <div id="scale_root">
      <div id="menu_area">
        <div id="watching_list">
          <div class="section_title">マップ一覧</div>
          <div id="server_list_cards"></div>
          <div id="upload_map_area">
            <div class="section_title section_title_row">
              オリジナルルームを作る
              <button id="btn_refresh_rooms">↺ 更新</button>
            </div>

            <div id="upload_room_cards"></div>

            <div class="upload_sub_section">
              <div class="upload_sub_label">ルームコードで参加</div>
              <div id="room_code_area">
                <input id="room_code_input" type="text" placeholder="例: A7F3C1"
                       style="text-transform:uppercase"
                       list="room_code_list">
                <datalist id="room_code_list"></datalist>
              </div>
            </div>

            <div class="upload_sub_section">
              <div class="upload_sub_label">新しいルームを作る</div>
              <div id="upload_map_buttons">
                <a href="/map-editor" id="open_editor_btn">マップを作る</a>
                <label for="upload_map_file" id="upload_map_label">マップをアップロード</label>
                <input type="file" id="upload_map_file" accept=".json" style="display:none">
              </div>
            </div>

            <div id="upload_map_status"></div>
          </div>
        </div>
        <div id="watching_info">

        </div>
      </div>
    </div>

    <script src="/javascripts/menu-watching.js"></script>

</body>

</html>